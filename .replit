modules = ["python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-5000} app:app"]

[workflows]
runButton = "Project"

[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000